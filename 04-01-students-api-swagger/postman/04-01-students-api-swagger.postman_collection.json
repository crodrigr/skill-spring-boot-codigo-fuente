{
  "info": {
    "name": "04-01-students-api-swagger",
    "description": "Colección de StudentController (04-01, API documentada con Swagger/springdoc). Ejecutar en orden: el primer request crea un estudiante y guarda su id en {{newId}}. Swagger UI: {{baseUrl}}/swagger-ui.html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "newId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Crear estudiante activo → 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "students"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana Torres\",\n  \"age\": 22,\n  \"email\": \"ana.swagger@mail.com\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Location presente\", function () { pm.response.to.have.header(\"Location\"); });",
              "pm.collectionVariables.set(\"newId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
