{
  "info": {
    "name": "05-01-students-api-exceptions",
    "description": "Colección de StudentController con manejo de excepciones (05-01). Ejecutar en orden (Runner) con la aplicación en marcha y la base vacía o sin esos correos: los dos primeros requests crean estudiantes y guardan sus ids en {{newId}} y {{otherId}}. Cada error valida el cuerpo ErrorResponse (timestamp, status, error, message, path, details).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "newId",
      "value": ""
    },
    {
      "key": "otherId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Crear estudiante → 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana Torres\",\n  \"age\": 22,\n  \"email\": \"ana.exc@mail.com\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Location presente\", function () { pm.response.to.have.header(\"Location\"); });",
              "pm.collectionVariables.set(\"newId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
