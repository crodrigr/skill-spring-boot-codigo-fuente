      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 409\", function () { pm.response.to.have.status(409); });",
              "pm.test(\"Cuerpo de error\", function () { var j = pm.response.json(); pm.expect(j).to.have.property(\"timestamp\"); pm.expect(j).to.have.property(\"message\"); pm.expect(j).to.have.property(\"path\"); });",
              "pm.test(\"Mensaje de correo\", function () { pm.expect(pm.response.json().error).to.eql(\"Conflict\"); });"
            ]
          }
        }
